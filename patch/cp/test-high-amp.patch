From: EBK21 <chkd13303@gmail.com>
Date: Tue, 14 Jan 2025 04:09:08 +0000
Subject: [PATCH] test high amp

---
 drivers/net/wireless/mediatek/mt76/mac80211.c        | 5 ++++-
 drivers/net/wireless/mediatek/mt76/mt76_connac_mcu.c | 2 +-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt76/mac80211.c b/drivers/net/wireless/mediatek/mt76/mac80211.c
index bf4541e76..950d3119e 100644
--- a/drivers/net/wireless/mediatek/mt76/mac80211.c
+++ b/drivers/net/wireless/mediatek/mt76/mac80211.c
@@ -1581,9 +1581,12 @@ int mt76_get_sar_power(struct mt76_phy *phy,
 	if (!capa || !phy->frp)
 		return power;
 
-	if (power > 127 || power < -127)
+	if (power > 252 || power < -127)
 		power = 127;
 
+	if (power > 127 && power <= 252)
+		return power;
+
 	freq = ieee80211_channel_to_frequency(chan->hw_value, chan->band);
 	for (i = 0 ; i < capa->num_freq_ranges; i++) {
 		if (phy->frp[i].range &&
diff --git a/drivers/net/wireless/mediatek/mt76/mt76_connac_mcu.c b/drivers/net/wireless/mediatek/mt76/mt76_connac_mcu.c
index 998cfd737..fc4e44aaf 100644
--- a/drivers/net/wireless/mediatek/mt76/mt76_connac_mcu.c
+++ b/drivers/net/wireless/mediatek/mt76/mt76_connac_mcu.c
@@ -2123,7 +2123,7 @@ static s8 mt76_connac_get_ch_power(struct mt76_phy *phy,
 
 				if (is_mt7663(dev) && (power > 63 || power < -64))
 					power = 63;
-				target_power = min_t(s8, power, target_power);
+				target_power = (target_power > 127 && target_power <= 252) ? target_power : min_t(s8, power, target_power);
 			}
 			break;
 		}
