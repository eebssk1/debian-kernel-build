 static void cake_reconfigure(struct Qdisc *sch);
 
+static inline bool cake_should_drop_burst(struct sk_buff *skb, struct Qdisc *sch,
+                                   struct cake_sched_data *q, u32 flow_backlog)
+{
+	u16 len;
+	u64 rate_Bps;
+	u64 dynamic_pressure_bytes;
+	u32 rtt_us;
+	const u16 SMALL_PKT_THRESH = 650;
+	const u16 MAX_STANDARD_MTU = 1536;
+	const u32 MIN_FLOW_BACKLOG = 10240;
+
+	if (q->rate_bps == 0) return false;
+	len = qdisc_pkt_len(skb);
+	rate_Bps = (u64)(q->rate_bps >> 3);
+	rtt_us = q->interval / NSEC_PER_USEC; /* target sojourn in ns -> us */
+
+	/*
+	 * Bandwidth-delay product: bytes that could be transmitted in
+	 * 83% of the configured target interval. If the total qdisc
+	 * backlog already exceeds this, the flow is building a queue
+	 * and we drop big packets early to signal congestion.
+	 *
+	 * u64 avoids overflow on links >= 4 Gbps.
+	 */
+	dynamic_pressure_bytes = rate_Bps * rtt_us / USEC_PER_SEC;
+	dynamic_pressure_bytes = dynamic_pressure_bytes * 83 / 100;
+
+	if ((u64)sch->qstats.backlog > dynamic_pressure_bytes &&
+	    flow_backlog > MIN_FLOW_BACKLOG &&
+	    len > SMALL_PKT_THRESH &&
+	    len <= MAX_STANDARD_MTU) {
+		return true;
+	}
+	return false;
+}
