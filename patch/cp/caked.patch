+/* 83% of this qdisc's BDP. rate is in B/s and includes any cake_mq adjustment.
+ * An unlimited rate or a threshold beyond the u32 backlog can never trip.
+ */
+static u32 cake_burst_threshold(u64 rate, u32 interval_us)
+{
+	u64 scaled;
+
+	if (!rate || check_mul_overflow(rate, 83ULL * interval_us, &scaled))
+		return U32_MAX;
+
+	return min_t(u64, div_u64(scaled, 100 * USEC_PER_SEC), U32_MAX);
+}
