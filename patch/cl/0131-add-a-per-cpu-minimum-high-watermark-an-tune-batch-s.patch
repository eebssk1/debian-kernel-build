From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arjan van de Ven <arjan.van.de.ven@intel.com>
Date: Tue, 23 Nov 2021 17:38:50 +0000
Subject: [PATCH] add a per cpu minimum high watermark an tune batch size

make sure there's at least 1024 per cpu pages... a reasonably small
amount for todays system
---
 mm/page_alloc.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/mm/page_alloc.c b/mm/page_alloc.c
index e6f211dcf82e..0ea48434ac7d 100644
--- a/mm/page_alloc.c
+++ b/mm/page_alloc.c
@@ -5906,6 +5906,8 @@
 {
 #ifdef CONFIG_MMU
 	int batch;
+	int znode = 0;
+	int mem = (totalram_pages() * PAGE_SIZE) >> 20;
 
 	/*
 	 * The number of pages to batch allocate is either ~0.1%
@@ -5913,7 +5915,11 @@
 	 * size is striking a balance between allocation latency
 	 * and zone lock contention.
 	 */
-	batch = min(zone_managed_pages(zone) >> 10, SZ_1M / PAGE_SIZE);
+	batch = min(zone_managed_pages(zone) >> 11, SZ_512K / PAGE_SIZE);
+	if (mem <= 2032) {
+		batch = (mem >= 640 ? 2 : 1) * SZ_1M / PAGE_SIZE;
+		batch = min(zone_managed_pages(zone) >> 10, batch);
+	}
 	batch /= 4;		/* We effectively *= 4 below */
 	if (batch < 1)
 		batch = 1;
@@ -5930,6 +5936,12 @@
 	 */
 	batch = rounddown_pow_of_two(batch + batch/2) - 1;
 
+#ifdef CONFIG_NUMA
+	znode = zone->node;
+#endif
+
+	pr_info_ratelimited("Mem Zone %d batch size is now %d KB.\n", znode, batch);
+	
 	return batch;
 
 #else
