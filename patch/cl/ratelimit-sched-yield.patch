From 467904416b3786c9f2b29ca683d36cb2523ae7ce Mon Sep 17 00:00:00 2001
From: Colin Ian King <colin.i.king@intel.com>
Date: Thu, 17 Oct 2024 16:29:50 +0100
Subject: [PATCH] sched: limit explicit yields per CPU

Run cond_resched() first, then admit up to four yields per CPU per 1 ms
window before taking the rq lock. Both sched_yield(2) and kernel yield()
use this path; yield_to() does not. Keep IRQs disabled from the clock
sample through rq acquisition so the budget and runqueue belong to the
same CPU. The donor, schedstats and schedule path are unchanged.

Signed-off-by: Colin Ian King <colin.i.king@intel.com>
---
--- a/kernel/sched/syscalls.c
+++ b/kernel/sched/syscalls.c
@@ -7,8 +7,9 @@
  *  Copyright (C) 1991-2002  Linus Torvalds
  *  Copyright (C) 1998-2024  Ingo Molnar, Red Hat
  */
 #include <linux/sched.h>
+#include <linux/sched/clock.h>
 #include <linux/cpuset.h>
 #include <linux/sched/debug.h>
 
 #include <uapi/linux/sched/types.h>
@@ -1332,14 +1333,36 @@ SYSCALL_DEFINE3(sched_getaffinity, pid_t
 
 	return ret;
 }
 
+#define YIELD_MAX_PER_MS	4
+
+static DEFINE_PER_CPU(u64, last_yield);
+static DEFINE_PER_CPU(unsigned int, yield_budget);
+
 static void do_sched_yield(void)
 {
 	struct rq_flags rf;
 	struct rq *rq;
+	u64 now;
+
+	cond_resched();
+
+	/* Charge the CPU that will yield, without locking its rq on denial. */
+	local_irq_disable();
+	now = local_clock();
+	if (now - __this_cpu_read(last_yield) >= NSEC_PER_MSEC) {
+		__this_cpu_write(last_yield, now);
+		__this_cpu_write(yield_budget, YIELD_MAX_PER_MS);
+	}
+	if (!__this_cpu_read(yield_budget)) {
+		local_irq_enable();
+		return;
+	}
+	__this_cpu_dec(yield_budget);
 
-	rq = this_rq_lock_irq(&rf);
+	rq = this_rq();
+	rq_lock(rq, &rf);
 
 	schedstat_inc(rq->yld_count);
 	rq->donor->sched_class->yield_task(rq);
 
